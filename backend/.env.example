PORT=4000
NODE_ENV=development

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Razorpay (Dashboard > API Keys). Test keys: rzp_test_...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Comma separated. Same-origin requests always work.
CORS_ORIGIN=http://localhost:4000

# Set to 1 when behind a proxy/load balancer (Render, Nginx, Cloudflare)
TRUST_PROXY=0

# Used only by: npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
